                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsAnimatedImageExportModeSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </DockPanel>

        <!--
            Non-intrusive toast notification stack: bottom-right corner,
            floating above all other content, never blocking input. Each
            item is a ToastNotificationViewModel and animates itself in via
            ToastCardStyle; auto-dismiss is scheduled by the ViewModel.
        -->
        <ItemsControl ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,18,18"
                      IsHitTestVisible="True"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Width="300" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ToastCardStyle}"
                            BorderBrush="{Binding Severity, Converter={StaticResource ToastSeverityBrushConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="{Binding Severity, Converter={StaticResource ToastSeverityBrushConverter}}"
                                    VerticalAlignment="Top">
                                <Path Data="{Binding Severity, Converter={StaticResource ToastSeverityIconConverter}}"
                                      Style="{StaticResource VectorIconStyle}"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      Width="12"
                                      Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}"
                                           Style="{StaticResource LabelStyle}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="48"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    ToolTip="{loc:Loc Key=toast.dismiss}"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="10" Height="10" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            Guided onboarding overlay (Phase v1.8.0): a semi-transparent
            scrim with a highlight border tracking the current step's
            target control (positioned in code-behind via TranslatePoint —
            see MainWindow.xaml.cs) and a callout with title/body text and
            Next/Skip. Topmost element in the window's visual tree so it
            draws above every panel, including toasts.
        -->
        <Grid x:Name="OnboardingOverlay"
              Visibility="{Binding IsOnboardingActive, Converter={StaticResource BooleanToVisibilityConverter}}"
              IsHitTestVisible="{Binding IsOnboardingActive}">
            <Grid.Resources>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource FastDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Rectangle Fill="#B3000000" />
            <Border x:Name="OnboardingHighlight"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False" />
            <Border x:Name="OnboardingCallout"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="18"
                    Width="280"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="OnboardingStepTitle"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="OnboardingStepBody"
                               Style="{StaticResource LabelStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OnboardingStepCounter"
                                   Grid.Column="0"
                                   Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc Key=onboarding.skip}"
                                Style="{StaticResource LinkButtonStyle}"
                                Command="{Binding SkipOnboardingCommand}"
                                HorizontalAlignment="Left"
                                Margin="8,0,0,0" />
                        <Button x:Name="OnboardingNextButton"
                                Grid.Column="2"
                                Content="{loc:Loc Key=onboarding.next}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NextOnboardingStepCommand}"
                                Padding="14,6" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Border>

</Window>
