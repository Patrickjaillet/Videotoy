<Window x:Class="Videotoy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Videotoy.App.ViewModels"
        xmlns:converters="clr-namespace:Videotoy.App.Converters"
        xmlns:loc="clr-namespace:Videotoy.App.Localization"
        xmlns:media="clr-namespace:Videotoy.Media;assembly=Videotoy.Media"
        Title="{loc:Loc Key=app.title}"
        Icon="pack://application:,,,/Assets/Icons/app.ico"
        Width="1180"
        Height="740"
        MinWidth="960"
        MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:IssueSeverityBrushConverter x:Key="IssueSeverityBrushConverter" />
        <converters:IssueSeverityIconConverter x:Key="IssueSeverityIconConverter" />
        <converters:PlaybackIconConverter x:Key="PlaybackIconConverter" />
        <converters:LoopSeamPreviewButtonTextConverter x:Key="LoopSeamPreviewButtonTextConverter" />
        <converters:ProgressRingArcConverter x:Key="ProgressRingArcConverter" />
        <converters:ToastSeverityBrushConverter x:Key="ToastSeverityBrushConverter" />
        <converters:ToastSeverityIconConverter x:Key="ToastSeverityIconConverter" />
        <converters:ExportHistoryResultBrushConverter x:Key="ExportHistoryResultBrushConverter" />
        <converters:ExportHistoryResultTextConverter x:Key="ExportHistoryResultTextConverter" />
        <converters:ContainerFormatDescriptionConverter x:Key="ContainerFormatDescriptionConverter" />
        <converters:RenderQueueItemStatusBrushConverter x:Key="RenderQueueItemStatusBrushConverter" />
        <converters:RenderQueueItemStatusTextConverter x:Key="RenderQueueItemStatusTextConverter" />

        <!--
            Backs the Shader Issues panel's severity/pass filter chips
            (Phase v1.8.0). The Filter predicate is a Predicate<object>
            delegate, not declaratively bindable, so it is wired in
            code-behind (MainWindow's constructor + OnShaderIssuesFilter):
            Source is assigned directly from the view model there, since a
            resource-dictionary CollectionViewSource has no DataContext to
            bind against. Refreshed via View.Refresh() whenever
            MainWindowViewModel.ShaderIssuesFilterChanged fires.
        -->
        <CollectionViewSource x:Key="ShaderIssuesViewSource" />

        <Storyboard x:Key="ExpandPanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="SettingsPanelColumn"
                              Storyboard.TargetProperty="Width"
                              To="320"
                              Duration="{StaticResource MediumDuration}" />
        </Storyboard>
        <Storyboard x:Key="CollapsePanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="SettingsPanelColumn"
                              Storyboard.TargetProperty="Width"
                              To="0"
                              Duration="{StaticResource MediumDuration}" />
        </Storyboard>

        <!--
            Transition between the "Edit" mode (interactive shader preview,
            all render settings editable) and the "Export" mode (settings
            locked, deterministic frame-by-frame encoding in progress):
            fades in a dark scrim with an export icon over the preview
            viewport, easing outward from a slight zoom so the switch reads
            as a deliberate mode change rather than a flat visibility flip.
            Reversed automatically on the way back out of export mode.
        -->
        <Style x:Key="ExportModeOverlayStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                  To="1"
                                                  Duration="{StaticResource MediumDuration}" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                  To="1.0"
                                                  Duration="{StaticResource MediumDuration}" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                  To="1.0"
                                                  Duration="{StaticResource MediumDuration}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                  To="0"
                                                  Duration="{StaticResource FastDuration}" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                  To="1.03"
                                                  Duration="{StaticResource FastDuration}" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                  To="1.03"
                                                  Duration="{StaticResource FastDuration}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Height="44"
                    MouseLeftButtonDown="OnTitleBarDrag"
                    KeyboardNavigation.TabNavigation="Local"
                    KeyboardNavigation.TabIndex="100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentBrush}">
                            <Path Data="{StaticResource IconLoop}"
                                  Style="{StaticResource VectorIconStyle}"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  Width="12"
                                  Height="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{loc:Loc Key=app.title}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />

                        <Menu Background="Transparent" Margin="24,0,0,0" VerticalAlignment="Center">
                            <MenuItem Header="{loc:Loc Key=menu.file}">
                                <MenuItem Header="{loc:Loc Key=menu.file.openShader}" Command="{Binding OpenShaderCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource IconFolderOpen}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=menu.file.recentShaders}" ItemsSource="{Binding RecentShaders}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding DisplayName}" />
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.OpenRecentShaderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Setter Property="CommandParameter" Value="{Binding FilePath}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{loc:Loc Key=menu.file.exit}" Click="OnExitClicked" />
                            </MenuItem>
                            <MenuItem Header="{loc:Loc Key=menu.edit}" />
                            <MenuItem Header="{loc:Loc Key=menu.render}">
                                <MenuItem Header="{loc:Loc Key=menu.render.exportMp4}" Command="{Binding ExportVideoCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource IconExport}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=export.history.panel.title}" Command="{Binding ToggleExportHistoryPanelCommand}" />
                                <MenuItem Header="{loc:Loc Key=renderQueue.panel.title}" Command="{Binding ToggleRenderQueuePanelCommand}" />
                            </MenuItem>
                            <MenuItem Header="{loc:Loc Key=menu.help}">
                                <MenuItem Header="{loc:Loc Key=menu.help.about}" Click="OnAboutClicked">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource IconInfo}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=menu.help.replayOnboarding}" Command="{Binding ReplayOnboardingCommand}" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource IconButtonStyle}" Click="OnMinimizeClicked" ToolTip="{loc:Loc Key=window.minimize}">
                            <Path Data="{StaticResource IconMinimize}" Style="{StaticResource VectorIconStyle}" Width="12" Height="12" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="OnMaximizeClicked" ToolTip="{loc:Loc Key=window.maximize}">
                            <Path Data="{StaticResource IconMaximize}" Style="{StaticResource VectorIconStyle}" Width="11" Height="11" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="OnCloseClicked" ToolTip="{loc:Loc Key=window.close}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Quick-action toolbar (Phase v1.8.0) — a fixed, developer-
                chosen order (no drag-to-reorder customization: the roadmap
                calls this "light"). Consolidates the most frequent actions,
                previously scattered across the menu and per-panel headers,
                into one always-visible row. Undo/Redo are relocated here
                (not duplicated) from the settings-panel header, fixing a
                real discoverability gap: they were previously unreachable
                whenever the settings panel was collapsed.
            -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Height="40"
                    KeyboardNavigation.TabNavigation="Local"
                    KeyboardNavigation.TabIndex="150">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenShaderCommand}" ToolTip="{loc:Loc Key=menu.file.openShader}">
                        <Path Data="{StaticResource IconFolderOpen}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ExportVideoCommand}" ToolTip="{loc:Loc Key=action.exportToMp4}">
                        <Path Data="{StaticResource IconExport}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ExportAnimatedImageCommand}" ToolTip="{loc:Loc Key=action.exportAnimatedImage}">
                        <Path Data="{StaticResource IconExportAnimatedImage}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="6,0" />

                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding UndoCommand}" ToolTip="{loc:Loc Key=panel.history.undo}">
                        <Path Data="{StaticResource IconUndo}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RedoCommand}" ToolTip="{loc:Loc Key=panel.history.redo}">
                        <Path Data="{StaticResource IconRedo}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="6,0" />

                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleIssuesPanelCommand}" ToolTip="{loc:Loc Key=issues.panel.title}">
                        <Path Data="{StaticResource IconWarning}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleExportHistoryPanelCommand}" ToolTip="{loc:Loc Key=export.history.panel.title}">
                        <Path Data="{StaticResource IconClock}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                    </Button>
                    <Button x:Name="RenderQueueToolbarButton" Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleRenderQueuePanelCommand}" ToolTip="{loc:Loc Key=renderQueue.panel.title}">
                        <Path Data="{StaticResource IconRenderQueue}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Height="30"
                    KeyboardNavigation.TabNavigation="Local"
                    KeyboardNavigation.TabIndex="500">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=statusBar.shaderLanguage.label}"
                                   Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   Visibility="{Binding IsShaderLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ComboBox ItemsSource="{Binding ShaderLanguageOptions}"
                                  SelectedItem="{Binding SelectedShaderLanguage}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="{loc:Loc Key=statusBar.shaderLanguage.tooltip}"
                                  FontSize="11"
                                  Padding="4,0"
                                  MinWidth="0"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Visibility="{Binding IsShaderLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{loc:LocFormat Key=statusBar.currentFrame, Path=CurrentFrame}"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,0,16,0" />
                        <TextBlock Text="{loc:LocFormat Key=statusBar.currentFps, Path=CurrentFps}"
                                   Style="{StaticResource LabelStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    MaxHeight="160"
                    Visibility="{Binding IsIssuesPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    KeyboardNavigation.TabNavigation="Local"
                    KeyboardNavigation.TabIndex="510">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="14,8,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Key=issues.panel.title}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="OnCloseIssuesPanelClicked" ToolTip="{loc:Loc Key=issues.panel.close}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,0,14,6">
                        <Path Data="{StaticResource IconFilter}"
                              Style="{StaticResource VectorIconStyle}"
                              Width="12"
                              Height="12"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <ToggleButton Style="{StaticResource FilterChipStyle}"
                                      Content="{loc:Loc Key=issues.filter.errors}"
                                      IsChecked="{Binding ShowErrorIssues}"
                                      Margin="0,0,6,0" />
                        <ToggleButton Style="{StaticResource FilterChipStyle}"
                                      Content="{loc:Loc Key=issues.filter.warnings}"
                                      IsChecked="{Binding ShowWarningIssues}"
                                      Margin="0,0,12,0" />
                        <ItemsControl ItemsSource="{Binding AvailablePassNames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ShaderIssuePassFilterViewModel}">
                                    <ToggleButton Style="{StaticResource FilterChipStyle}"
                                                  Content="{Binding PassName}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Margin="0,0,6,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,0,14,10">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource ShaderIssuesViewSource}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Path Data="{Binding IsError, Converter={StaticResource IssueSeverityIconConverter}}"
                                              Style="{StaticResource VectorIconStyle}"
                                              Stroke="{Binding IsError, Converter={StaticResource IssueSeverityBrushConverter}}"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Top" />
                                        <TextBlock Text="{loc:LocFormat Key=issues.panel.line, Path=Line}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Width="60" />
                                        <TextBlock Text="{Binding PassName}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Width="90" />
                                        <TextBlock Text="{Binding Message}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding IsError, Converter={StaticResource IssueSeverityBrushConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    MaxHeight="220"
                    Visibility="{Binding IsExportHistoryPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    KeyboardNavigation.TabNavigation="Local"
                    KeyboardNavigation.TabIndex="520">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="14,8,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Key=export.history.panel.title}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleExportHistoryPanelCommand}" ToolTip="{loc:Loc Key=export.history.toggle.collapse}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="11" Height="11" />
                        </Button>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Loc Key=export.history.empty}"
                               Style="{StaticResource LabelStyle}"
                               Margin="14,4,14,10"
                               Visibility="{Binding HasExportHistory, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,0,14,10">
                        <ItemsControl ItemsSource="{Binding ExportHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}">
                                                <Run Text="{Binding ShaderDisplayName, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding ResolutionWidth, Mode=OneWay}" />
                                                <Run Text="x" />
                                                <Run Text="{Binding ResolutionHeight, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding CodecName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{loc:Loc Key=export.history.entry.durationLabel}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding EncodingDuration, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Result, Converter={StaticResource ExportHistoryResultBrushConverter}}"
                                                   Text="{Binding Result, Converter={StaticResource ExportHistoryResultTextConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    MaxHeight="320"
                    Visibility="{Binding IsRenderQueuePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    KeyboardNavigation.TabNavigation="Local"
                    KeyboardNavigation.TabIndex="530">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="14,8,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconRenderQueue}" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc Key=renderQueue.panel.title}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleRenderQueuePanelCommand}" ToolTip="{loc:Loc Key=renderQueue.panel.toggle.collapse}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="14,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{loc:Loc Key=renderQueue.add.video}"
                                Command="{Binding AddCurrentToRenderQueueCommand}"
                                CommandParameter="{x:Static media:RenderQueueItemKind.Video}"
                                Margin="0,0,6,0" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc Key=renderQueue.add.animatedImage}"
                                Command="{Binding AddCurrentToRenderQueueCommand}"
                                CommandParameter="{x:Static media:RenderQueueItemKind.AnimatedImage}"
                                Margin="0,0,6,0" />

                        <Button Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding StartRenderQueueCommand}"
                                ToolTip="{loc:Loc Key=renderQueue.start}"
                                Visibility="{Binding IsRenderQueueRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource IconPlay}" Style="{StaticResource VectorIconStyle}" Width="12" Height="12" />
                        </Button>
                        <Button Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding PauseRenderQueueCommand}"
                                ToolTip="{loc:Loc Key=renderQueue.pause}"
                                Visibility="{Binding IsRenderQueueRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource IconPause}" Style="{StaticResource VectorIconStyle}" Width="12" Height="12" />
                        </Button>
                        <Button Grid.Column="4"
                                Content="{loc:Loc Key=renderQueue.resume}"
                                Command="{Binding ResumeRenderQueueCommand}"
                                Visibility="{Binding IsRenderQueuePaused, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="6,0,0,0" />
                        <Button Grid.Column="5"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CancelRenderQueueCommand}"
                                ToolTip="{loc:Loc Key=renderQueue.cancelAll}"
                                Margin="6,0,0,0">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="11" Height="11" />
                        </Button>
                    </Grid>

                    <Grid DockPanel.Dock="Top"
                          Margin="14,0,14,8"
                          Visibility="{Binding IsRenderQueueRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource LabelStyle}">
                            <Run Text="{loc:Loc Key=renderQueue.progress.overallLabel}" />
                            <Run Text=" " />
                            <Run Text="{Binding RenderQueueCurrentItemIndex, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding RenderQueueTotalItemCount, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Grid.Row="1"
                                     Style="{StaticResource ExportProgressBarStyle}"
                                     Value="{Binding RenderQueueOverallProgressPercent, Mode=OneWay}"
                                     Margin="0,4,0,0" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Loc Key=renderQueue.empty}"
                               Style="{StaticResource LabelStyle}"
                               Margin="14,4,14,10"
                               Visibility="{Binding HasRenderQueueItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,0,14,10">
                        <ListBox x:Name="RenderQueueListBox"
                                 ItemsSource="{Binding RenderQueue}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnRenderQueueItemPreviewMouseLeftButtonDown"
                                 PreviewMouseMove="OnRenderQueueItemPreviewMouseMove"
                                 Drop="OnRenderQueueItemDrop">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="8" Cursor="SizeAll">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="64"
                                                    Height="36"
                                                    Background="{StaticResource ViewportBackgroundBrush}"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding ShaderDisplayName, Mode=OneWay}" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding OutputFileName, Mode=OneWay}" />
                                                <ProgressBar Style="{StaticResource ExportProgressBarStyle}"
                                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                                             Height="4"
                                                             Margin="0,4,0,0"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="8,0"
                                                       Foreground="{Binding Status, Converter={StaticResource RenderQueueItemStatusBrushConverter}}"
                                                       Text="{Binding Status, Converter={StaticResource RenderQueueItemStatusTextConverter}}" />

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.CancelRenderQueueItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc Key=renderQueue.item.cancel}"
                                                    Margin="0,0,4,0">
                                                <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="10" Height="10" />
                                            </Button>
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.RemoveRenderQueueItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc Key=renderQueue.item.remove}">
                                                <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="10" Height="10" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsPanelColumn" Width="320" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="ViewportRegion" Grid.Column="0" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="300">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource CardBorderStyle}"
                                Width="800"
                                Height="450"
                                Background="{StaticResource ViewportBackgroundBrush}"
                                Padding="0">
                            <Grid Cursor="Hand"
                                  ToolTip="{loc:Loc Key=viewport.dropHint}"
                                  ToolTipService.ShowOnDisabled="True">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsShaderLoaded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <Path Data="{StaticResource IconFolderOpen}"
                                          Style="{StaticResource VectorIconStyle}"
                                          Stroke="#FF5A5D62"
                                          Width="32"
                                          Height="32"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc Key=viewport.dropHint}"
                                               Foreground="#FF8A8D92"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,0" />
                                </StackPanel>

                                <Image Source="{Binding PreviewImageSource}"
                                       Width="800"
                                       Height="450"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"
                                       Visibility="{Binding IsShaderLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <Border x:Name="ExportModeOverlay"
                                        Style="{StaticResource ExportModeOverlayStyle}"
                                        Background="#CC0C0C0E"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ExportModeOverlayScaleTransform" ScaleX="1.03" ScaleY="1.03" />
                                    </Border.RenderTransform>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                            <!--
                                                Static track ring (full circle, dim) so the animated
                                                indicator arc below always reads against a visible
                                                background, at any progress percentage.
                                            -->
                                            <Ellipse Width="36"
                                                     Height="36"
                                                     Stroke="#33FFFFFF"
                                                     StrokeThickness="3" />

                                            <!--
                                                Slowly breathing halo behind the ring: continuous
                                                pulse so the overlay reads as "actively working" even
                                                during long gaps between progress updates.
                                            -->
                                            <Ellipse x:Name="RenderPulseHalo"
                                                     Width="52"
                                                     Height="52"
                                                     Stroke="{StaticResource AccentBrush}"
                                                     StrokeThickness="1.4"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                        <BeginStoryboard Storyboard="{StaticResource RenderPulseStoryboard}" />
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>

                                            <!--
                                                Progress indicator arc: its Data geometry sweeps from
                                                the top, clockwise, in proportion to ExportProgressPercent.
                                            -->
                                            <Path Width="36"
                                                  Height="36"
                                                  Data="{Binding ExportProgressPercent, Converter={StaticResource ProgressRingArcConverter}}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="3"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />

                                            <Path Data="{StaticResource IconExport}"
                                                  Style="{StaticResource VectorIconStyle}"
                                                  Stroke="White"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{loc:Loc Key=export.progress.title}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0" />
                                        <TextBlock Text="{loc:LocFormat Key=export.progress.percent, Path=ExportProgressPercent}"
                                                   Foreground="#FFC8CACD"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,10,0,0"
                              Width="800"
                              Visibility="{Binding IsShaderLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center"
                                    Command="{Binding TogglePlaybackCommand}">
                                <Path Data="{Binding IsPlaying, Converter={StaticResource PlaybackIconConverter}}"
                                      Style="{StaticResource VectorIconStyle}"
                                      Width="12"
                                      Height="12" />
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    Command="{Binding StopPlaybackCommand}">
                                <Path Data="{StaticResource IconClose}"
                                      Style="{StaticResource VectorIconStyle}"
                                      Width="10"
                                      Height="10" />
                            </Button>

                            <Slider x:Name="TimelineSlider"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="12,0,12,0"
                                    Minimum="0"
                                    Maximum="{Binding LoopDurationSeconds}"
                                    Value="{Binding PlaybackTimeSeconds, Mode=OneWay}"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="OnTimelineDragStarted"
                                    PreviewMouseLeftButtonUp="OnTimelineDragCompleted"
                                    ValueChanged="OnTimelineValueChanged" />

                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource LabelStyle}"
                                       Text="{loc:LocFormat Key=viewport.timeline.currentTime, Path=PlaybackTimeSeconds}" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="TogglePanelButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Click="OnTogglePanelClicked">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="ToolTip" Value="{loc:Loc Key=panel.toggle.collapse}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPanelOpen}" Value="False">
                                        <Setter Property="ToolTip" Value="{loc:Loc Key=panel.toggle.expand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path x:Name="TogglePanelIcon"
                              Data="{StaticResource IconChevronRight}"
                              Style="{StaticResource VectorIconStyle}"
                              Width="12"
                              Height="12" />
                    </Button>
                </Grid>

                <Border x:Name="SettingsPanelRegion"
                        Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        ClipToBounds="True"
                        KeyboardNavigation.TabNavigation="Local"
                        KeyboardNavigation.TabIndex="400">
                    <Border.InputBindings>
                        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
                        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
                    </Border.InputBindings>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=panel.renderSettings}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />

                            <TextBlock Text="{loc:Loc Key=panel.exportKind.sectionLabel}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,18">
                                <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                          ItemsSource="{Binding ExportKindOptions}"
                                          SelectedItem="{Binding SelectedExportKind}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                            </Border>

                            <TextBlock Text="{loc:Loc Key=panel.exportPresets.sectionLabel}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=panel.exportPresets.load}" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  Style="{StaticResource FieldComboBoxStyle}"
                                                  ItemsSource="{Binding ExportPresets}"
                                                  SelectedItem="{Binding SelectedExportPreset}"
                                                  DisplayMemberPath="Name"
                                                  IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                        <Button Grid.Column="2"
                                                Content="{loc:Loc Key=panel.exportPresets.load.action}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding LoadExportPresetCommand}"
                                                IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                        <Button Grid.Column="4"
                                                Content="{loc:Loc Key=panel.exportPresets.delete.action}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DeleteExportPresetCommand}"
                                                IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                    </Grid>

                                    <TextBlock Text="{loc:Loc Key=panel.exportPresets.saveAs}" Style="{StaticResource LabelStyle}" Margin="0,14,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource FieldTextBoxStyle}"
                                                 Text="{Binding NewExportPresetName, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                        <Button Grid.Column="2"
                                                Content="{loc:Loc Key=panel.exportPresets.save.action}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding SaveExportPresetCommand}"
                                                IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                    </Grid>
                                    <TextBlock Text="{loc:Loc Key=panel.exportPresets.description}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <ToggleButton Style="{StaticResource CollapsibleGroupHeaderStyle}"
                                          Content="{loc:Loc Key=panel.group.resolutionFps.sectionLabel}"
                                          IsChecked="{Binding IsResolutionGroupExpanded}"
                                          Margin="0,0,0,6" />
                            <StackPanel Visibility="{Binding IsResolutionGroupExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{loc:Loc Key=panel.resolution.sectionLabel}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,18">
                                <StackPanel>
                                    <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                              ItemsSource="{Binding ResolutionPresets}"
                                              SelectedItem="{Binding SelectedResolutionPreset}"
                                              DisplayMemberPath="DisplayName"
                                              IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                    <Grid Margin="0,10,0,0"
                                          Visibility="{Binding SelectedResolutionPreset.IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc Key=panel.resolution.width}" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
                                            <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding CustomResolutionWidth, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}"
                                                     GotFocus="OnUndoableTextBoxGotFocus"
                                                     LostFocus="OnUndoableTextBoxLostFocus" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc Key=panel.resolution.height}" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
                                            <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding CustomResolutionHeight, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}"
                                                     GotFocus="OnUndoableTextBoxGotFocus"
                                                     LostFocus="OnUndoableTextBoxLostFocus" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:Loc Key=panel.frameRate.sectionLabel}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,18">
                                <StackPanel>
                                    <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                              ItemsSource="{Binding FrameRatePresets}"
                                              SelectedItem="{Binding SelectedFrameRatePreset}"
                                              DisplayMemberPath="DisplayName"
                                              IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding SelectedFrameRatePreset.IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{loc:Loc Key=panel.frameRate.custom.label}" Style="{StaticResource LabelStyle}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                 Text="{Binding CustomFrameRateValue, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}"
                                                 GotFocus="OnUndoableTextBoxGotFocus"
                                                 LostFocus="OnUndoableTextBoxLostFocus" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <ToggleButton Style="{StaticResource CollapsibleGroupHeaderStyle}"
                                          Content="{loc:Loc Key=panel.group.durationLoop.sectionLabel}"
                                          IsChecked="{Binding IsDurationLoopGroupExpanded}"
                                          Margin="0,0,0,6" />
                            <StackPanel Visibility="{Binding IsDurationLoopGroupExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{loc:Loc Key=panel.durationMode.sectionLabel}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,18">
                                <StackPanel>
                                    <RadioButton Content="{loc:Loc Key=panel.durationMode.manual}"
                                                 GroupName="DurationMode"
                                                 IsChecked="{Binding IsSeamlessLoopModeEnabled, Converter={StaticResource InverseBooleanConverter}}"
                                                 IsEnabled="{Binding IsSeamlessLoopModeToggleEnabled}"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                    <RadioButton Content="{loc:Loc Key=panel.durationMode.seamlessLoop}"
                                                 GroupName="DurationMode"
                                                 IsChecked="{Binding IsSeamlessLoopModeEnabled}"
                                                 IsEnabled="{Binding IsSeamlessLoopModeToggleEnabled}"
                                                 Margin="0,8,0,0"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc Key=panel.durationMode.animatedImageLocked}"
                                                TextWrapping="Wrap"
                                                Style="{StaticResource LabelStyle}"
                                                Margin="0,6,0,0"
                                                Visibility="{Binding IsAnimatedImageExportModeSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Grid Margin="0,12,0,0"
                                          Visibility="{Binding IsSeamlessLoopModeEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource FieldTextBoxStyle}"
                                                 Text="{Binding ManualDurationValue, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}"
                                                 GotFocus="OnUndoableTextBoxGotFocus"
                                                 LostFocus="OnUndoableTextBoxLostFocus" />
                                        <ComboBox Grid.Column="2"
                                                  Style="{StaticResource FieldComboBoxStyle}"
                                                  SelectedIndex="{Binding ManualDurationUnitIndex}"
                                                  IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}">
                                            <ComboBoxItem Content="{loc:Loc Key=panel.durationMode.unit.seconds}" />
                                            <ComboBoxItem Content="{loc:Loc Key=panel.durationMode.unit.frames}" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,12,0,0"
                                          Visibility="{Binding IsSeamlessLoopModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource FieldTextBoxStyle}"
                                                 Text="{Binding LoopDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Loc Key=panel.durationMode.loopSecondsPerLoop}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource LabelStyle}" />
                                    </Grid>
                                    <TextBlock Text="{loc:Loc Key=panel.durationMode.loopHint}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding IsSeamlessLoopModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="{loc:Loc Key=panel.durationMode.exclusiveEndFrame}"
                                              IsChecked="{Binding IsLoopEndFrameExclusive}"
                                              IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              Margin="0,10,0,0"
                                              Visibility="{Binding IsSeamlessLoopModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{loc:Loc Key=panel.durationMode.exclusiveEndFrame.description}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding IsSeamlessLoopModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Visibility="{Binding HasLoopRoundingMismatch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,8,0,0">
                                        <TextBlock Text="{loc:Loc Key=panel.durationMode.loopRoundingMismatch}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource DangerBrush}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{loc:LocFormat Key=panel.durationMode.loopRoundingMismatch.suggested, Path=SuggestedLoopDurationSeconds}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource LabelStyle}" />
                                            <Button Grid.Column="2"
                                                    Content="{loc:Loc Key=action.apply}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding ApplyAssistedLoopRoundingCommand}"
                                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasDetectedLoopPeriod, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,8,0,0">
                                        <TextBlock Text="{loc:Loc Key=panel.durationMode.detectedLoopPeriod}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{loc:LocFormat Key=panel.durationMode.detectedLoopPeriod.source, Path=DetectedLoopPeriodSourceText}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   FontFamily="Consolas"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{loc:Loc Key=panel.durationMode.detectedLoopPeriod.multiple}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   Style="{StaticResource LabelStyle}"
                                                   Visibility="{Binding HasMultipleDetectedLoopPeriods, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{loc:LocFormat Key=panel.durationMode.detectedLoopPeriod.suggested, Path=DetectedLoopPeriodSeconds}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource LabelStyle}" />
                                            <Button Grid.Column="2"
                                                    Content="{loc:Loc Key=action.apply}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding ApplyDetectedLoopPeriodCommand}"
                                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding IsSeamlessLoopModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{loc:Loc Key=panel.loopSeamPreview.sectionLabel}" Style="{StaticResource LabelStyle}" Margin="0,0,0,6" />
                                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Key=panel.loopSeamPreview.description}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource LabelStyle}" />

                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding HasLoopSeamPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Key=panel.loopSeamPreview.firstFrame}"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource LabelStyle}"
                                                           Margin="0,0,0,4" />
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding LoopSeamStartFrameImageSource}"
                                                           Stretch="Uniform" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Loc Key=panel.loopSeamPreview.lastFrame}"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource LabelStyle}"
                                                           Margin="0,0,0,4" />
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding LoopSeamEndFrameImageSource}"
                                                           Stretch="Uniform" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="{Binding IsGeneratingLoopSeamPreview, Converter={StaticResource LoopSeamPreviewButtonTextConverter}}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding GenerateLoopSeamPreviewCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,12,0,0" />
