<Window x:Class="Videotoy.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Videotoy.App.Localization"
        Title="{loc:Loc Key=app.title}"
        Icon="pack://application:,,,/Assets/Icons/app.ico"
        Width="360"
        Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False">

    <Window.Resources>
        <Storyboard x:Key="LogoSpinStoryboard">
            <DoubleAnimation Storyboard.TargetName="LogoRotateTransform"
                              Storyboard.TargetProperty="Angle"
                              From="0"
                              To="360"
                              Duration="0:0:1.6"
                              RepeatBehavior="Forever" />
        </Storyboard>

        <Storyboard x:Key="LogoPulseStoryboard">
            <DoubleAnimation Storyboard.TargetName="LogoBadge"
                              Storyboard.TargetProperty="Opacity"
                              From="0.55"
                              To="1.0"
                              Duration="0:0:0.9"
                              AutoReverse="True"
                              RepeatBehavior="Forever" />
        </Storyboard>

        <Storyboard x:Key="ProgressSweepStoryboard">
            <DoubleAnimation Storyboard.TargetName="ProgressIndicatorTransform"
                              Storyboard.TargetProperty="X"
                              From="-96"
                              To="264"
                              Duration="0:0:1.1"
                              RepeatBehavior="Forever" />
        </Storyboard>

        <Storyboard x:Key="WindowFadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                              Storyboard.TargetProperty="Opacity"
                              From="0"
                              To="1"
                              Duration="0:0:0.22" />
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowFadeInStoryboard}" />
            <BeginStoryboard Storyboard="{StaticResource LogoSpinStoryboard}" />
            <BeginStoryboard Storyboard="{StaticResource LogoPulseStoryboard}" />
            <BeginStoryboard Storyboard="{StaticResource ProgressSweepStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder"
            Style="{StaticResource CardBorderStyle}"
            Effect="{StaticResource PopupShadow}"
            Opacity="0">
        <Grid Margin="0,32,0,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="LogoBadge"
                    Grid.Row="0"
                    Width="64"
                    Height="64"
                    CornerRadius="16"
                    Background="{StaticResource AccentBrush}"
                    Effect="{StaticResource AccentGlow}"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Path Data="{StaticResource IconLoop}"
                      Stroke="White"
                      StrokeThickness="1.8"
                      Width="30"
                      Height="30"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="LogoRotateTransform" Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{loc:Loc Key=app.title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0" />

            <TextBlock Grid.Row="2"
                       Text="{loc:Loc Key=splash.loading}"
                       Style="{StaticResource LabelStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />

            <Border Grid.Row="4"
                    Width="240"
                    Height="4"
                    CornerRadius="2"
                    Background="{StaticResource SurfaceAltBrush}"
                    HorizontalAlignment="Center"
                    ClipToBounds="True">
                <Border Width="96"
                        Height="4"
                        CornerRadius="2"
                        Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressIndicatorTransform" X="-96" />
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>

</Window>
