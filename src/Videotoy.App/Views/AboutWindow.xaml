<Window x:Class="Videotoy.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Videotoy.App.Localization"
        Title="{loc:Loc Key=about.windowTitle}"
        Width="420"
        Height="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Style="{StaticResource CardBorderStyle}" Margin="12" Effect="{StaticResource PopupShadow}">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource IconButtonStyle}"
                    Click="OnCloseClicked"
                    KeyboardNavigation.TabIndex="1">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource VectorIconStyle}" Width="12" Height="12" />
            </Button>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentBrush}">
                    <Path Data="{StaticResource IconLoop}"
                          Style="{StaticResource VectorIconStyle}"
                          Stroke="White"
                          StrokeThickness="1.8"
                          Width="30"
                          Height="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding ApplicationName}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
                <TextBlock Text="{Binding Version}"
                           Style="{StaticResource LabelStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Copyright}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center" />
                <Button Content="{Binding Email}"
                        Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding CopyEmailCommand}"
                        Margin="0,6,0,0"
                        KeyboardNavigation.TabIndex="2" />
                <Button Content="{Binding Website}"
                        Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding OpenWebsiteCommand}"
                        Margin="0,2,0,0"
                        KeyboardNavigation.TabIndex="3" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Center">
                <TextBlock Text="{loc:Loc Key=about.language.label}"
                           Style="{StaticResource LabelStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                          MinWidth="160"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="DisplayName"
                          KeyboardNavigation.TabIndex="4" />
            </StackPanel>

            <Button Grid.Row="5"
                    Content="{loc:Loc Key=about.close}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center"
                    MinWidth="120"
                    Margin="0,24,0,0"
                    Click="OnCloseClicked"
                    KeyboardNavigation.TabIndex="5" />

        </Grid>
    </Border>

</Window>
