<?xml version="1.0"?>
<SyntaxDefinition name="GLSL" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Preprocessor" foreground="#9B9B9B" />
  <Color name="Keyword" foreground="#569CD6" fontWeight="bold" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="Qualifier" foreground="#C586C0" fontWeight="bold" />
  <Color name="BuiltinVariable" foreground="#DCDCAA" />
  <Color name="BuiltinFunction" foreground="#DCDCAA" />
  <Color name="Number" foreground="#B5CEA8" />

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
    </Span>
    <Span color="Preprocessor" begin="^\s*#" />

    <Keywords color="Qualifier">
      <Word>in</Word>
      <Word>out</Word>
      <Word>inout</Word>
      <Word>uniform</Word>
      <Word>const</Word>
      <Word>varying</Word>
      <Word>attribute</Word>
      <Word>flat</Word>
      <Word>centroid</Word>
      <Word>precision</Word>
      <Word>highp</Word>
      <Word>mediump</Word>
      <Word>lowp</Word>
    </Keywords>

    <Keywords color="Keyword">
      <Word>if</Word>
      <Word>else</Word>
      <Word>for</Word>
      <Word>while</Word>
      <Word>do</Word>
      <Word>break</Word>
      <Word>continue</Word>
      <Word>return</Word>
      <Word>discard</Word>
      <Word>struct</Word>
      <Word>void</Word>
      <Word>true</Word>
      <Word>false</Word>
      <Word>switch</Word>
      <Word>case</Word>
      <Word>default</Word>
    </Keywords>

    <Keywords color="Type">
      <Word>float</Word>
      <Word>double</Word>
      <Word>int</Word>
      <Word>uint</Word>
      <Word>bool</Word>
      <Word>vec2</Word>
      <Word>vec3</Word>
      <Word>vec4</Word>
      <Word>ivec2</Word>
      <Word>ivec3</Word>
      <Word>ivec4</Word>
      <Word>uvec2</Word>
      <Word>uvec3</Word>
      <Word>uvec4</Word>
      <Word>bvec2</Word>
      <Word>bvec3</Word>
      <Word>bvec4</Word>
      <Word>mat2</Word>
      <Word>mat3</Word>
      <Word>mat4</Word>
      <Word>sampler2D</Word>
      <Word>samplerCube</Word>
      <Word>sampler3D</Word>
    </Keywords>

    <Keywords color="BuiltinVariable">
      <Word>gl_FragColor</Word>
      <Word>gl_FragCoord</Word>
      <Word>fragColor</Word>
      <Word>fragCoord</Word>
      <Word>iResolution</Word>
      <Word>iTime</Word>
      <Word>iTimeDelta</Word>
      <Word>iFrame</Word>
      <Word>iFrameRate</Word>
      <Word>iChannelTime</Word>
      <Word>iChannelResolution</Word>
      <Word>iMouse</Word>
      <Word>iDate</Word>
      <Word>iSampleRate</Word>
      <Word>iChannel0</Word>
      <Word>iChannel1</Word>
      <Word>iChannel2</Word>
      <Word>iChannel3</Word>
    </Keywords>

    <Keywords color="BuiltinFunction">
      <Word>mainImage</Word>
      <Word>mod</Word>
      <Word>fract</Word>
      <Word>mix</Word>
      <Word>clamp</Word>
      <Word>smoothstep</Word>
      <Word>step</Word>
      <Word>abs</Word>
      <Word>sign</Word>
      <Word>floor</Word>
      <Word>ceil</Word>
      <Word>round</Word>
      <Word>min</Word>
      <Word>max</Word>
      <Word>pow</Word>
      <Word>exp</Word>
      <Word>log</Word>
      <Word>exp2</Word>
      <Word>log2</Word>
      <Word>sqrt</Word>
      <Word>inversesqrt</Word>
      <Word>sin</Word>
      <Word>cos</Word>
      <Word>tan</Word>
      <Word>asin</Word>
      <Word>acos</Word>
      <Word>atan</Word>
      <Word>length</Word>
      <Word>distance</Word>
      <Word>dot</Word>
      <Word>cross</Word>
      <Word>normalize</Word>
      <Word>reflect</Word>
      <Word>refract</Word>
      <Word>texture</Word>
      <Word>textureLod</Word>
      <Word>texelFetch</Word>
    </Keywords>

    <Rule color="Number">
      \b0[xX][0-9a-fA-F]+\b
      |	\b
      (	\d+(\.[0-9]+)?
      |	\.[0-9]+
      )
      ([eE][+-]?[0-9]+)?
      [fFuUlL]?
      \b
    </Rule>
  </RuleSet>
</SyntaxDefinition>
